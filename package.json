{
  "name": "quantro",
  "version": "1.0.0",
  "private": true,
  "description": "Quantro — Kuantum ve Astrofizik ARGE · statik site + Vercel serverless API",
  "keywords": [
    "kuantum",
    "astrofizik",
    "AGRE",
    "quantum",
    "vercel",
    "supabase"
  ],
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/quantro.test.js test/_lib.test.js test/api-handlers.test.js test/localize.test.js",
    "test:e2e": "node --test test/e2e.test.js",
    "test:coverage": "node scripts/coverage.mjs",
    "metrics:field": "node scripts/metrics.mjs",
    "audit": "npm audit --omit=dev",
    "check": "npm run build && npm test",
    "pkg:sync": "node tools/sync-pkg.mjs",
    "pkg:test": "node tools/sync-pkg.mjs && npm --prefix package/quantro test",
    "pkg:pack": "node tools/sync-pkg.mjs && npm --prefix package/quantro pack --dry-run"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}